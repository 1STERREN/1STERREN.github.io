<div id="mobile-drawer" class="fixed inset-x-0 top-20 bg-surface border-b border-border-base shadow-xl p-5 z-30 hidden md:hidden max-h-[calc(100vh-5rem)] overflow-y-auto">
  <div class="flex flex-col gap-2">
