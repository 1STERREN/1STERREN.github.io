---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import { createWhatsAppUrl, createBoQMailtoUrl } from '@/utils/links';
import { getMaterialPhoto } from '@/utils/materialPhotos';

interface SectionItem {
  name: string;
  description?: string;
}

interface Section {
  title: string;
  items: SectionItem[];
}

interface Props {
  unitBusinessName: string;
  category?: 'beton' | 'baja' | 'aspal' | 'batuan';
  description: string;
  sections: Section[];
  datasheetUrl?: string | null;
  photoSrc?: string;
}

const { 
  unitBusinessName, 
  category = 'beton',
  description, 
  sections, 
  datasheetUrl = null,
  photoSrc = '/images/foto-beton-readymix.jpg'
} = Astro.props;

const mailtoUrl = createBoQMailtoUrl(`Permintaan Penawaran - ${unitBusinessName}`);
---

<Layout title={`${unitBusinessName} | Katalog Spesifikasi Material | CV. Serba Niaga Jaya`}>
  <!-- Hero Unit Bisnis -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5">
        <PhotoSlot 
          aspectRatio="16/9" 
          label={`Dokumentasi Lapangan ${unitBusinessName}`}
          src={photoSrc}
          alt={`Dokumentasi Lapangan ${unitBusinessName}`}
        />
      </div>
      <div class="lg:col-span-7 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-[#E5F6E8] text-xs font-mono font-bold text-[#0F7B3F] border border-[#12A150]/20">
            <span class="w-2 h-2 rounded-full bg-[#12A150]"></span>
            UNIT NIAGA RESMI CV. SERBA NIAGA JAYA
          </span>
          <span class="text-xs font-mono text-gray-500 bg-surface-soft px-2.5 py-1 rounded border border-border-base">
            Jabodetabek & Karawang
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">{unitBusinessName}</h1>
        <p class="text-sm sm:text-base text-ink opacity-85 leading-relaxed">{description}</p>
        
        <div class="pt-2 flex flex-wrap gap-3 items-center">
          <Button href={createWhatsAppUrl(`Konsultasi Pengadaan ${unitBusinessName}`)} target="_blank">
            Konsultasi WhatsApp
          </Button>
          <Button href={mailtoUrl} variant="secondary">
            Kirim BoQ / Penawaran
          </Button>

          {datasheetUrl && (
            <a 
              href={datasheetUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-[6px] border border-border-base text-xs font-bold text-ink bg-surface hover:bg-surface-soft transition-colors"
            >
              <svg class="w-4 h-4 text-green-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Unduh Datasheet (PDF)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Marketplace Section: Katalog Produk Grid & Konsultasi Langsung -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-t border-border-base">
    
    <!-- Header Section Marketplace -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FFC700]"></span>
          <span class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider">
            KATALOG SPESIFIKASI PASOKAN RESMI
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-ink">Katalog Pasokan & Tanya Penawaran Resmi</h2>
        <p class="text-xs sm:text-sm text-ink/75 mt-1">
          Pilih material sesuai kebutuhan proyek Anda, konsultasikan spesifikasi dan dapatkan penawaran harga resmi langsung via WhatsApp.
        </p>
      </div>

      <!-- Quick Navigasi Seksi Material -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full">
        {sections.map((section, idx) => (
          <a 
            href={`#section-${idx}`}
            class="text-[11px] font-bold text-ink/80 hover:text-green-primary bg-surface-soft border border-border-base px-3 py-1.5 rounded-[6px] whitespace-nowrap transition-colors hover:border-[#12A150]/50"
          >
            {section.title.split('.')[1] || section.title}
          </a>
        ))}
      </div>
    </div>

    <!-- Looping Tiap Kategori / Seksi Material -->
    <div class="space-y-12">
      {sections.map((section, sIdx) => (
        <div id={`section-${sIdx}`} class="scroll-mt-24">
          
          <!-- Header Bar Seksi -->
          <div class="bg-surface-soft border border-border-base rounded-t-[10px] px-6 py-4 flex items-center justify-between">
            <h3 class="text-base sm:text-lg font-black text-ink flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[#E5F6E8] text-[#0F7B3F] text-xs font-bold font-mono flex items-center justify-center shrink-0">
                0{sIdx + 1}
              </span>
              <span>{section.title}</span>
            </h3>
            <span class="text-xs font-mono text-gray-500 font-bold bg-surface px-2.5 py-1 rounded border border-border-base/70">
              {section.items.length} Pilihan Material
            </span>
          </div>

          <!-- Grid Marketplace Cards (3 Kolom Responsive) -->
          <div class="border-x border-b border-border-base rounded-b-[10px] bg-surface p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 shadow-sm">
            {section.items.map((item, itemIdx) => {
              const specificPhoto = getMaterialPhoto(category, item.name);

              return (
                <div class="marketplace-card border border-border-base rounded-[10px] bg-surface overflow-hidden flex flex-col justify-between hover:border-[#12A150]/60 hover:shadow-lg transition-all duration-200 group">
                  
                  <div>
                    <!-- Visual Thumbnail Header Bersih & Terang -->
                    <div class="relative h-44 bg-surface-soft overflow-hidden border-b border-border-base">
                      <img 
                        src={specificPhoto} 
                        alt={item.name} 
                        loading="lazy" 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      
                      <!-- Label Kategori Bersih -->
                      <div class="absolute top-2.5 left-2.5">
                        <span class="bg-surface/95 text-[10px] font-mono font-bold text-[#0A4D2E] px-2 py-0.5 rounded shadow-xs border border-border-base">
                          {unitBusinessName}
                        </span>
                      </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5">
                      <div class="flex items-center justify-between text-[11px] font-mono text-gray-500 mb-2">
                        <span class="flex items-center gap-1 font-mono text-[10px] text-[#0A4D2E]">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#12A150] animate-pulse"></span>
                          Siap Pasok Proyek
                        </span>
                      </div>
                      <h4 class="text-sm sm:text-base font-black text-ink mb-1.5 group-hover:text-green-primary transition-colors line-clamp-2 min-h-[2.75rem]">
                        {item.name}
                      </h4>
                      {item.description && (
                        <p class="text-xs text-ink/75 leading-relaxed line-clamp-2 min-h-[2rem]">
                          {item.description}
                        </p>
                      )}
                    </div>
                  </div>

                  <!-- Card Action: Tanya Langsung via WhatsApp -->
                  <div class="p-5 pt-0">
                    <div class="pt-3 border-t border-border-base/70">
                      <a 
                        href={createWhatsAppUrl(`Halo CV. Serba Niaga Jaya, saya ingin menanyakan spesifikasi & penawaran resmi untuk: ${item.name} (${unitBusinessName})`)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full bg-[#EAF7ED] hover:bg-[#D5EEDB] active:scale-98 text-[#0D6838] border border-[#12A150]/30 hover:border-[#12A150]/60 font-bold text-xs py-3 px-3 rounded-[6px] shadow-xs flex items-center justify-center gap-2 transition-all"
                        title={`Tanya Penawaran ${item.name} via WhatsApp`}
                      >
                        <svg class="w-4 h-4 text-[#0D6838] shrink-0" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.97.53 1.77.82 2.79.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.766-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.435-4.733-1.199l-5.267 1.381 1.405-5.137c-.896-1.493-1.405-3.237-1.405-5.045 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
                        </svg>
                        <span>Tanya via WhatsApp</span>
                      </a>
                    </div>
                  </div>

                </div>
              );
            })}
          </div>

        </div>
      ))}
    </div>

  </section>

  <!-- Banner Penutup Transparan & Tanpa Friksi -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-[#E5F6E8] border-t-2 border-[#0A4D2E] border-x border-b border-border-base rounded-[8px] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
      <div>
        <h3 class="text-xl font-black text-ink">Butuh Jadwal Pengiriman & Ritase Armada?</h3>
        <p class="text-xs sm:text-sm text-ink opacity-80 mt-1">
          Koordinasikan akses jalan proyek, kapasitas angkut ritase, dan waktu pengiriman langsung dengan tim operasional {unitBusinessName}.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <Button href={createWhatsAppUrl(`Konsultasi Ritase Lapangan - ${unitBusinessName}`)} target="_blank">
          Chat WhatsApp
        </Button>
        <Button href={mailtoUrl} variant="secondary">
          Email BoQ
        </Button>
      </div>
    </div>
  </section>
</Layout>
