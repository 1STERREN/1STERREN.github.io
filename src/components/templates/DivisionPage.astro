---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import { createWhatsAppUrl, createBoQMailtoUrl } from '@/utils/links';
import { getMaterialPhoto } from '@/utils/materialPhotos';

interface SectionItem {
  name: string;
  description?: string;
}

interface Section {
  title: string;
  items: SectionItem[];
}

interface Props {
  unitBusinessName: string;
  category?: 'beton' | 'baja' | 'aspal' | 'batuan';
  description: string;
  sections: Section[];
  datasheetUrl?: string | null;
  photoSrc?: string;
}

const { 
  unitBusinessName, 
  category = 'beton',
  description, 
  sections, 
  datasheetUrl = null,
  photoSrc = '/images/foto-beton-readymix.jpg'
} = Astro.props;

const mailtoUrl = createBoQMailtoUrl(`Permintaan Penawaran - ${unitBusinessName}`);

// Helper satuan otomatis berdasarkan kategori dan nama material
function getMaterialUnit(cat: string, name: string): string {
  const n = name.toLowerCase();
  if (cat === 'beton') {
    if (n.includes('pompa')) return 'Sesi';
    if (n.includes('u-ditch') || n.includes('cover') || n.includes('box culvert') || n.includes('buis') || n.includes('kanstin')) return 'Pcs';
    if (n.includes('paving')) return 'm²';
    return 'm³';
  }
  if (cat === 'baja') {
    if (n.includes('wiremesh')) return 'Lembar';
    if (n.includes('alderon') || n.includes('spandek') || n.includes('polycarbonate')) return 'Lembar';
    if (n.includes('plat')) return 'Lembar';
    return 'Batang';
  }
  if (cat === 'aspal') {
    if (n.includes('drum') || n.includes('curah')) return 'Drum';
    if (n.includes('emulsi') || n.includes('cair')) return 'Drum';
    if (n.includes('jasa')) return 'm²';
    return 'Ton';
  }
  if (cat === 'batuan') {
    if (n.includes('bata') || n.includes('hebel')) return 'm³';
    if (n.includes('pasir')) return 'Rit';
    if (n.includes('split') || n.includes('agregat') || n.includes('makadam') || n.includes('sirdam')) return 'Rit';
    if (n.includes('batu kali') || n.includes('batu belah')) return 'Rit';
    return 'Rit';
  }
  return 'Unit';
}

// Helper badge standar resmi
function getMaterialStandardBadge(cat: string, name: string): string {
  const n = name.toLowerCase();
  if (cat === 'beton') {
    if (n.includes('kelas iii') || n.includes('k-350') || n.includes('k-500')) return 'SNI 2847 Heavy Duty';
    if (n.includes('precast') || n.includes('u-ditch') || n.includes('box')) return 'Precast K-350 SNI';
    if (n.includes('pompa')) return 'Armada Pompa SNJ';
    return 'SNI 2847 / PBI';
  }
  if (cat === 'baja') {
    if (n.includes('ulir') || n.includes('ts 420')) return 'SNI 2052 BjTS 420';
    if (n.includes('polos')) return 'SNI 2052 BjTP 280';
    if (n.includes('wf') || n.includes('h-beam')) return 'ASTM / JIS Grade';
    if (n.includes('alderon')) return 'Original uPVC Twinwall';
    return 'Mill Sheet SNI';
  }
  if (cat === 'aspal') {
    if (n.includes('ac-wc') || n.includes('ac-bc')) return 'Bina Marga Rev 3';
    if (n.includes('pen 60/70')) return 'Pertamina Resmi';
    if (n.includes('emulsi') || n.includes('tack') || n.includes('prime')) return 'SNI 03-4798';
    return 'Standar Jalan Raya';
  }
  if (cat === 'batuan') {
    if (n.includes('pasir')) return 'Lumpur < 5% Bebas Organik';
    if (n.includes('split')) return 'Gradasi Kuat Tekan Cor';
    if (n.includes('hebel')) return 'Presisi AAC SNI';
    return 'Kuari Terverifikasi';
  }
  return 'Standar SNI';
}
---

<Layout title={`${unitBusinessName} | Katalog Material & Keranjang Belanja | CV. Serba Niaga Jaya`}>
  <!-- Hero Unit Bisnis -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5">
        <PhotoSlot 
          aspectRatio="16/9" 
          label={`Dokumentasi Lapangan ${unitBusinessName}`}
          src={photoSrc}
          alt={`Dokumentasi Lapangan ${unitBusinessName}`}
        />
      </div>
      <div class="lg:col-span-7 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-[#E5F6E8] text-xs font-mono font-bold text-[#0F7B3F] border border-[#12A150]/20">
            <span class="w-2 h-2 rounded-full bg-[#12A150]"></span>
            UNIT BISNIS RESMI CV. SERBA NIAGA JAYA
          </span>
          <span class="text-xs font-mono text-gray-500 bg-surface-soft px-2.5 py-1 rounded border border-border-base">
            Jabodetabek & Karawang
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">{unitBusinessName}</h1>
        <p class="text-sm sm:text-base text-ink opacity-85 leading-relaxed">{description}</p>
        
        <div class="pt-2 flex flex-wrap gap-3 items-center">
          <Button href={createWhatsAppUrl(`Konsultasi Pengadaan ${unitBusinessName}`)} target="_blank">
            Konsultasi WhatsApp
          </Button>
          <Button href={mailtoUrl} variant="secondary">
            Kirim BoQ / Penawaran
          </Button>

          {datasheetUrl && (
            <a 
              href={datasheetUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-[6px] border border-border-base text-xs font-bold text-ink bg-surface hover:bg-surface-soft transition-colors"
            >
              <svg class="w-4 h-4 text-green-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Unduh Datasheet (PDF)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Marketplace Section: Katalog Produk Grid & Tambah ke Keranjang -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-t border-border-base">
    
    <!-- Header Section Marketplace -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FFC700]"></span>
          <span class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider">
            KATALOG PASOKAN GAYA MARKETPLACE
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-ink">Pilih Material & Masukkan ke Keranjang</h2>
        <p class="text-xs sm:text-sm text-ink/75 mt-1">
          Tentukan jumlah volume kebutuhan material Anda, lalu checkout sekaligus melalui WhatsApp resmi.
        </p>
      </div>

      <!-- Quick Navigasi Seksi Material -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full">
        {sections.map((section, idx) => (
          <a 
            href={`#section-${idx}`}
            class="text-[11px] font-bold text-ink/80 hover:text-green-primary bg-surface-soft border border-border-base px-3 py-1.5 rounded-[6px] whitespace-nowrap transition-colors hover:border-[#12A150]/50"
          >
            {section.title.split('.')[1] || section.title}
          </a>
        ))}
      </div>
    </div>

    <!-- Looping Tiap Kategori / Seksi Material -->
    <div class="space-y-12">
      {sections.map((section, sIdx) => (
        <div id={`section-${sIdx}`} class="scroll-mt-24">
          
          <!-- Header Bar Seksi -->
          <div class="bg-surface-soft border border-border-base rounded-t-[10px] px-6 py-4 flex items-center justify-between">
            <h3 class="text-base sm:text-lg font-black text-ink flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[#E5F6E8] text-[#0F7B3F] text-xs font-bold font-mono flex items-center justify-center shrink-0">
                0{sIdx + 1}
              </span>
              <span>{section.title}</span>
            </h3>
            <span class="text-xs font-mono text-gray-500 font-bold bg-surface px-2.5 py-1 rounded border border-border-base/70">
              {section.items.length} Pilihan Material
            </span>
          </div>

          <!-- Grid Marketplace Cards (3 Kolom Responsive) -->
          <div class="border-x border-b border-border-base rounded-b-[10px] bg-surface p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 shadow-sm">
            {section.items.map((item, itemIdx) => {
              const unit = getMaterialUnit(category, item.name);
              const badge = getMaterialStandardBadge(category, item.name);
              const itemId = `${category}-${sIdx}-${itemIdx}-${item.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
              const specificPhoto = getMaterialPhoto(category, item.name);

              return (
                <div class="marketplace-card border border-border-base rounded-[10px] bg-surface overflow-hidden flex flex-col justify-between hover:border-[#12A150]/60 hover:shadow-lg transition-all duration-200 group">
                  
                  <div>
                    <!-- Visual Thumbnail Header Bersih & Terang -->
                    <div class="relative h-44 bg-surface-soft overflow-hidden border-b border-border-base">
                      <img 
                        src={specificPhoto} 
                        alt={item.name} 
                        loading="lazy" 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      
                      <!-- Top Badges Kontras Tinggi -->
                      <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between gap-2">
                        <span class="bg-surface/95 text-[10px] font-mono font-bold text-[#0A4D2E] px-2 py-0.5 rounded shadow-xs border border-border-base">
                          {unitBusinessName}
                        </span>
                        <span class="bg-[#FFC700] text-ink text-[9px] font-mono font-black px-2 py-0.5 rounded shadow-xs">
                          {badge}
                        </span>
                      </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5">
                      <div class="flex items-center justify-between text-[11px] font-mono text-gray-500 mb-2">
                        <span class="text-green-primary font-bold bg-[#E5F6E8] px-2 py-0.5 rounded border border-[#12A150]/20">
                          Satuan: {unit}
                        </span>
                        <span class="flex items-center gap-1 font-mono text-[10px] text-[#0A4D2E]">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#12A150] animate-pulse"></span>
                          Siap Pasok Proyek
                        </span>
                      </div>
                      <h4 class="text-sm sm:text-base font-black text-ink mb-1.5 group-hover:text-green-primary transition-colors line-clamp-2 min-h-[2.75rem]">
                        {item.name}
                      </h4>
                      {item.description && (
                        <p class="text-xs text-ink/75 leading-relaxed line-clamp-2 min-h-[2rem]">
                          {item.description}
                        </p>
                      )}
                    </div>
                  </div>

                  <!-- Card Marketplace Controls & Action -->
                  <div class="p-5 pt-0">
                    <div class="pt-3 border-t border-border-base/70">
                      
                      <!-- Quantity Stepper -->
                      <div class="flex items-center justify-between gap-2 mb-3">
                        <span class="text-[11px] font-bold text-ink/80">Jumlah Kebutuhan:</span>
                        <div class="flex items-center border border-border-base rounded-[6px] overflow-hidden bg-surface-soft shadow-xs">
                          <button 
                            type="button" 
                            class="card-qty-minus px-2.5 py-1 text-ink/75 hover:text-ink hover:bg-surface font-bold text-xs transition-colors" 
                            aria-label="Kurangi Kuantitas"
                          >
                            -
                          </button>
                          <span class="card-qty-value px-3 py-1 font-mono text-xs font-bold text-ink bg-surface min-w-[42px] text-center border-x border-border-base">
                            1
                          </span>
                          <button 
                            type="button" 
                            class="card-qty-plus px-2.5 py-1 text-ink/75 hover:text-ink hover:bg-surface font-bold text-xs transition-colors" 
                            aria-label="Tambah Kuantitas"
                          >
                            +
                          </button>
                        </div>
                      </div>

                      <!-- Action Buttons -->
                      <div class="grid grid-cols-12 gap-2">
                        <button 
                          type="button"
                          class="col-span-8 btn-add-to-cart bg-[#FFC700] hover:bg-[#E5B300] active:scale-98 text-ink font-bold text-xs py-2.5 px-3 rounded-[6px] shadow-sm flex items-center justify-center gap-1.5 transition-all"
                          data-id={itemId}
                          data-name={item.name}
                          data-unit-business={unitBusinessName}
                          data-category={category}
                          data-unit={unit}
                          data-spec={item.description || ''}
                        >
                          <svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                          </svg>
                          <span>+ Keranjang</span>
                        </button>

                        <a 
                          href={createWhatsAppUrl(`Halo CV. SNJ, saya ingin tanya ketersediaan & jadwal kirim: ${item.name} (${unitBusinessName})`)}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="col-span-4 border border-border-base hover:bg-surface-soft active:scale-98 text-ink font-bold text-xs py-2.5 px-2 rounded-[6px] flex items-center justify-center gap-1 transition-colors"
                          title="Tanya Spesifikasi ke WhatsApp"
                        >
                          <svg class="w-3.5 h-3.5 text-green-primary" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.97.53 1.77.82 2.79.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.766-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.435-4.733-1.199l-5.267 1.381 1.405-5.137c-.896-1.493-1.405-3.237-1.405-5.045 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
                          </svg>
                          <span>Tanya</span>
                        </a>
                      </div>

                    </div>
                  </div>

                </div>
              );
            })}
          </div>

        </div>
      ))}
    </div>

  </section>

  <!-- Banner Penutup Transparan & Tanpa Friksi -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-[#E5F6E8] border-t-2 border-[#0A4D2E] border-x border-b border-border-base rounded-[8px] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
      <div>
        <h3 class="text-xl font-black text-ink">Butuh Jadwal Pengiriman & Ritase Armada?</h3>
        <p class="text-xs sm:text-sm text-ink opacity-80 mt-1">
          Koordinasikan akses jalan proyek, kapasitas angkut ritase, dan waktu pengiriman langsung dengan tim operasional {unitBusinessName}.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <Button href={createWhatsAppUrl(`Konsultasi Ritase Lapangan - ${unitBusinessName}`)} target="_blank">
          Chat WhatsApp
        </Button>
        <Button href={mailtoUrl} variant="secondary">
          Email BoQ
        </Button>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Marketplace Card Stepper & Add to Cart Client-Side Handler
  document.addEventListener('DOMContentLoaded', () => {
    
    // Card Stepper
    document.querySelectorAll('.marketplace-card').forEach(card => {
      const minusBtn = card.querySelector('.card-qty-minus');
      const plusBtn = card.querySelector('.card-qty-plus');
      const qtyEl = card.querySelector('.card-qty-value');

      minusBtn?.addEventListener('click', () => {
        let val = Number(qtyEl?.textContent?.trim()) || 1;
        if (val > 1) {
          val -= 1;
          if (qtyEl) qtyEl.textContent = String(val);
        }
      });

      plusBtn?.addEventListener('click', () => {
        let val = Number(qtyEl?.textContent?.trim()) || 1;
        val += 1;
        if (qtyEl) qtyEl.textContent = String(val);
      });
    });

    // Add To Cart Event
    document.querySelectorAll('.btn-add-to-cart').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.marketplace-card');
        const qtyEl = card?.querySelector('.card-qty-value');
        const qty = Number(qtyEl?.textContent?.trim()) || 1;

        const id = btn.getAttribute('data-id') || '';
        const name = btn.getAttribute('data-name') || '';
        const unitBusiness = btn.getAttribute('data-unit-business') || '';
        const category = btn.getAttribute('data-category') || '';
        const unit = btn.getAttribute('data-unit') || '';
        const spec = btn.getAttribute('data-spec') || '';

        const item = { id, name, unitBusiness, category, unit, spec, qty };

        // Read LocalStorage
        let cart = [];
        try {
          const raw = localStorage.getItem('snj_cart_items_v1');
          cart = raw ? JSON.parse(raw) : [];
        } catch (e) {
          cart = [];
        }

        const existingIdx = cart.findIndex((i: { id: string }) => i.id === id);
        if (existingIdx >= 0) {
          cart[existingIdx].qty += qty;
        } else {
          cart.push(item);
        }

        try {
          localStorage.setItem('snj_cart_items_v1', JSON.stringify(cart));
        } catch (e) {
          console.error(e);
        }

        // Notify global events
        window.dispatchEvent(new CustomEvent('snj-cart-updated', { detail: cart }));
        window.dispatchEvent(new CustomEvent('snj-toast', { detail: `${qty} ${unit} ${name} ditambahkan ke keranjang!` }));

        // Micro-interaction button state
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="w-4 h-4 text-green-800 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-[#0A4D2E] font-black">Ditambahkan</span>
        `;
        btn.classList.add('bg-[#E5F6E8]', 'border', 'border-[#12A150]');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-[#E5F6E8]', 'border', 'border-[#12A150]');
        }, 1200);
      });
    });

  });
</script>
