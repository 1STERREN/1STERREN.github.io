---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
---

<Layout title="404 - Halaman Tidak Ditemukan | CV. Serba Niaga Jaya">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <span class="text-4xl font-black font-mono text-green-primary mb-2 block">404</span>
    <h1 class="text-2xl sm:text-3xl font-black text-ink mb-4">Halaman Tidak Ditemukan</h1>
    <p class="text-sm text-ink opacity-80 mb-8 leading-relaxed">
      Halaman yang Anda tuju mungkin telah dipindahkan atau tautan spesifikasi tidak valid.
    </p>
    <div class="flex justify-center gap-3">
      <Button href="/produk">
        Ke Katalog Produk
      </Button>
      <Button href="/" variant="secondary">
        Kembali ke Beranda
      </Button>
    </div>
  </section>
</Layout>
