---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import SpecChip from '@/components/ui/SpecChip.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import PhotoCarousel from '@/components/ui/PhotoCarousel.astro';
import { createWhatsAppUrl, createBoQMailtoUrl } from '@/utils/links';

const waHeroUrl = createWhatsAppUrl("Material Konstruksi Umum");
const waBetonUrl = createWhatsAppUrl("Beton Ready Mix & Precast");
const waBajaUrl = createWhatsAppUrl("Baja Tulangan SNI");
const waAspalUrl = createWhatsAppUrl("Aspal Hotmix");
const waBatuanUrl = createWhatsAppUrl("Agregat Pasir & Batu Split");
const mailtoUrl = createBoQMailtoUrl();
---

<Layout>
  <!-- 01. HERO TERPUSAT -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[6px] bg-green-light border border-border-base text-xs font-bold text-ink mb-6">
      <span class="w-2 h-2 rounded-full bg-green-primary"></span>
      <span>Wilayah Distribusi: Jabodetabek, Cikarang & Karawang</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-ink tracking-tight leading-[1.15] mb-6">
      Material konstruksi lengkap, satu pintu.
    </h1>

    <p class="text-base sm:text-lg text-ink leading-relaxed max-w-2xl mx-auto mb-8 opacity-90">
      Penyedia terpercaya beton ready-mix, baja tulangan bersertifikat, aspal hotmix, dan agregat batuan standar SNI untuk kelancaran proyek Anda.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <Button href={waHeroUrl} target="_blank">
        <span>Konsultasi via WhatsApp</span>
        <svg class="w-4 h-4 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </Button>

      <Button href="#kategori" variant="secondary">
        <span>Lihat Katalog Spesifikasi</span>
      </Button>
    </div>
  </section>

  <!-- 02. CAROUSEL FOTO OTOMATIS BERGERAK (Dokumentasi Material & Proyek Aktual) -->
  <PhotoCarousel />

  <!-- 03. STRIP KOMITMEN EMPAT BUTIR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-y border-border-base my-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
      <div class="flex items-start gap-3">
        <span class="text-green-primary font-black text-base">✓</span>
        <div>
          <h4 class="text-xs font-bold text-ink uppercase tracking-wider">Rujukan Standar SNI</h4>
          <p class="text-xs text-ink opacity-80 mt-0.5">Spesifikasi teknis mengikuti uji laboratorium resmi.</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="text-green-primary font-black text-base">✓</span>
        <div>
          <h4 class="text-xs font-bold text-ink uppercase tracking-wider">Jadwal Ritase Pasti</h4>
          <p class="text-xs text-ink opacity-80 mt-0.5">Waktu pengiriman dikonfirmasi langsung per pesanan.</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="text-green-primary font-black text-base">✓</span>
        <div>
          <h4 class="text-xs font-bold text-ink uppercase tracking-wider">Penawaran Tertulis</h4>
          <p class="text-xs text-ink opacity-80 mt-0.5">Dokumen resmi BoQ/RAB diterbitkan via email resmi.</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="text-green-primary font-black text-base">✓</span>
        <div>
          <h4 class="text-xs font-bold text-ink uppercase tracking-wider">Distribusi Terkoordinasi</h4>
          <p class="text-xs text-ink opacity-80 mt-0.5">Melayani Jabodetabek, Cikarang, dan Karawang.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04. EMPAT KATEGORI MATERIAL (Asimetris: 1 Besar + 3 Kecil) -->
  <section id="kategori" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider mb-1">01 &mdash; PASOKAN TERPADU</div>
        <h2 class="text-2xl sm:text-3xl font-black text-ink">Empat Kategori Niaga</h2>
        <p class="text-xs sm:text-sm text-ink/75 mt-1">Klik pada kategori untuk melihat spesifikasi lengkap dan belanja material.</p>
      </div>
      <a href="/produk" class="text-xs font-bold text-green-primary hover:underline inline-flex items-center gap-1 shrink-0">
        <span>Buka Semua Katalog</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- 01. Niaga Beton -->
      <a 
        href="/niaga-beton" 
        class="border border-border-base rounded-[12px] bg-surface p-5 industrial-card flex flex-col justify-between group hover:border-[#12A150] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block cursor-pointer"
      >
        <div>
          <!-- Foto Bersih Tanpa Teks Gelap -->
          <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-surface-soft border border-border-base/70 mb-4 relative">
            <img 
              src="/images/foto-cor-mixer-chute.jpg" 
              alt="Niaga Beton Ready Mix dan Precast" 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute top-2.5 left-2.5 text-[10px] font-mono font-bold text-[#0A4D2E] bg-white/95 backdrop-blur-sm px-2 py-0.5 rounded shadow-sm border border-[#12A150]/20">
              SNI 2847 / PUPR
            </span>
          </div>

          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-green-primary">01</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-green-primary transition-colors">
              Niaga Beton
            </h3>
          </div>
          <div class="text-xs font-semibold text-ink/80 mb-2">Ready Mix, Precast & Pompa</div>
          <p class="text-xs text-ink/70 leading-relaxed mb-4">
            Beton cor curah struktur K-100 s/d K-500, saluran drainase U-Ditch presisi, Box Culvert, & armada pompa cor.
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">K-225 s/d K-500</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">U-Ditch</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Pompa Cor</span>
          </div>
        </div>

        <div class="pt-3 border-t border-border-base/60 flex items-center justify-between text-xs font-bold text-green-primary">
          <span>Buka Katalog</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
      </a>

      <!-- 02. Niaga Baja -->
      <a 
        href="/niaga-baja" 
        class="border border-border-base rounded-[12px] bg-surface p-5 industrial-card flex flex-col justify-between group hover:border-[#12A150] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block cursor-pointer"
      >
        <div>
          <!-- Foto Bersih Tanpa Teks Gelap -->
          <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-surface-soft border border-border-base/70 mb-4 relative">
            <img 
              src="/images/foto-baja-rebar.jpg" 
              alt="Niaga Baja Tulangan dan Profil" 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute top-2.5 left-2.5 text-[10px] font-mono font-bold text-[#0A4D2E] bg-white/95 backdrop-blur-sm px-2 py-0.5 rounded shadow-sm border border-[#12A150]/20">
              SNI 2052:2017
            </span>
          </div>

          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-green-primary">02</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-green-primary transition-colors">
              Niaga Baja
            </h3>
          </div>
          <div class="text-xs font-semibold text-ink/80 mb-2">Besi Tulangan, Wiremesh & WF</div>
          <p class="text-xs text-ink/70 leading-relaxed mb-4">
            Besi beton polos (TP 280) & ulir (TS 420B), wiremesh rol/lembar, profil baja WF, H-Beam, dan atap Alderon.
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">BjTS 420B</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Wiremesh M8</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">WF & H-Beam</span>
          </div>
        </div>

        <div class="pt-3 border-t border-border-base/60 flex items-center justify-between text-xs font-bold text-green-primary">
          <span>Buka Katalog</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
      </a>

      <!-- 03. Niaga Aspal -->
      <a 
        href="/niaga-aspal" 
        class="border border-border-base rounded-[12px] bg-surface p-5 industrial-card flex flex-col justify-between group hover:border-[#12A150] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block cursor-pointer"
      >
        <div>
          <!-- Foto Bersih Tanpa Teks Gelap -->
          <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-surface-soft border border-border-base/70 mb-4 relative">
            <img 
              src="/images/serba aspal/Aspal AC WC.png" 
              alt="Niaga Aspal Hotmix Jalan" 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute top-2.5 left-2.5 text-[10px] font-mono font-bold text-[#0A4D2E] bg-white/95 backdrop-blur-sm px-2 py-0.5 rounded shadow-sm border border-[#12A150]/20">
              Bina Marga Rev 3
            </span>
          </div>

          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-green-primary">03</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-green-primary transition-colors">
              Niaga Aspal
            </h3>
          </div>
          <div class="text-xs font-semibold text-ink/80 mb-2">Hotmix, Aspal Drum & Emulsi</div>
          <p class="text-xs text-ink/70 leading-relaxed mb-4">
            Campuran aspal panas AC-WC & AC-BC, aspal penetrasi Pen 60/70 Pertamina, Tack/Prime Coat, dan jasa gelar.
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">AC-WC & AC-BC</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Pen 60/70</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Tack Coat</span>
          </div>
        </div>

        <div class="pt-3 border-t border-border-base/60 flex items-center justify-between text-xs font-bold text-green-primary">
          <span>Buka Katalog</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
      </a>

      <!-- 04. Niaga Batuan -->
      <a 
        href="/niaga-batuan" 
        class="border border-border-base rounded-[12px] bg-surface p-5 industrial-card flex flex-col justify-between group hover:border-[#12A150] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block cursor-pointer"
      >
        <div>
          <!-- Foto Bersih Tanpa Teks Gelap -->
          <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-surface-soft border border-border-base/70 mb-4 relative">
            <img 
              src="/images/foto-batuan-agregat.jpg" 
              alt="Niaga Batuan Agregat dan Pasir" 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute top-2.5 left-2.5 text-[10px] font-mono font-bold text-[#0A4D2E] bg-white/95 backdrop-blur-sm px-2 py-0.5 rounded shadow-sm border border-[#12A150]/20">
              ASTM C33 / SNI
            </span>
          </div>

          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold text-green-primary">04</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-green-primary transition-colors">
              Niaga Batuan
            </h3>
          </div>
          <div class="text-xs font-semibold text-ink/80 mb-2">Pasir Cuci, Split & Bata Hebel</div>
          <p class="text-xs text-ink/70 leading-relaxed mb-4">
            Pasir cor cuci bebas lumpur (&lt;5%), batu split gradasi 1/2 & 2/3, batu kali pondasi, serta bata ringan AAC.
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Pasir Cor Cuci</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Split 1/2</span>
            <span class="text-[10px] font-mono bg-surface-soft px-2 py-0.5 rounded border border-border-base text-ink/80">Bata Hebel</span>
          </div>
        </div>

        <div class="pt-3 border-t border-border-base/60 flex items-center justify-between text-xs font-bold text-green-primary">
          <span>Buka Katalog</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
      </a>
    </div>
  </section>

  <!-- 05. CARA PEMESANAN (Foto 4:5 + 4 Langkah Bernomor Kuning) -->
  <section id="cara-pesan" class="bg-surface-soft border-y border-border-base py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <div class="lg:col-span-5">
          <PhotoSlot 
            aspectRatio="4/5" 
            src="/images/foto-pasir-dump-truck.jpg"
            alt="Armada dump truck pengiriman material konstruksi"
            label="Koordinasi Ritase Lapangan" 
            sublabel="Terhubung Langsung Tim Teknis" 
          />
        </div>

        <div class="lg:col-span-7 space-y-6">
          <div>
            <div class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider mb-1">02 &mdash; ALUR KERJA</div>
            <h2 class="text-2xl sm:text-3xl font-black text-ink">Empat Langkah Pemesanan</h2>
            <p class="text-sm text-ink opacity-80 mt-2">Tanpa form isian publik. Komunikasi berjalan terarah dan langsung.</p>
          </div>

          <div class="space-y-4">
            <div class="p-4 rounded-[8px] border border-border-base bg-surface flex gap-4 items-start">
              <span class="text-base font-mono font-black text-[#111111] bg-[#FFC700] px-2.5 py-1 rounded border border-[#E5B300]">01</span>
              <div>
                <h4 class="text-sm font-bold text-ink">Tanya via WhatsApp</h4>
                <p class="text-xs text-ink opacity-80 mt-0.5">Sampaikan kebutuhan material, lokasi proyek di Jabodetabek/Karawang, dan estimasi waktu pengecoran atau instalasi.</p>
              </div>
            </div>

            <div class="p-4 rounded-[8px] border border-border-base bg-surface flex gap-4 items-start">
              <span class="text-base font-mono font-black text-[#111111] bg-[#FFC700] px-2.5 py-1 rounded border border-[#E5B300]">02</span>
              <div>
                <h4 class="text-sm font-bold text-ink">Konfirmasi Spesifikasi & Ritase</h4>
                <p class="text-xs text-ink opacity-80 mt-0.5">Tim teknis memverifikasi mutu beton, diameter baja, jadwal ketersediaan mixer/dump truck, dan akses jalan proyek.</p>
              </div>
            </div>

            <div class="p-4 rounded-[8px] border border-border-base bg-surface flex gap-4 items-start">
              <span class="text-base font-mono font-black text-[#111111] bg-[#FFC700] px-2.5 py-1 rounded border border-[#E5B300]">03</span>
              <div>
                <h4 class="text-sm font-bold text-ink">Penawaran Resmi via Email</h4>
                <p class="text-xs text-ink opacity-80 mt-0.5">Dokumen penawaran harga resmi (BoQ/RAB) diterbitkan melalui email resmi lengkap dengan syarat teknis terikat.</p>
              </div>
            </div>

            <div class="p-4 rounded-[8px] border border-border-base bg-surface flex gap-4 items-start">
              <span class="text-base font-mono font-black text-[#111111] bg-[#FFC700] px-2.5 py-1 rounded border border-[#E5B300]">04</span>
              <div>
                <h4 class="text-sm font-bold text-ink">Pengiriman Sesuai Jadwal</h4>
                <p class="text-xs text-ink opacity-80 mt-0.5">Armada diberangkatkan tepat waktu dari batching plant atau gudang distribusi terdekat sesuai jadwal ritase.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 06. PANEL PRESISI SPESIFIKASI (Hijau Tua Deep Forest #0A4D2E) -->
  <section id="spesifikasi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="rounded-[12px] bg-[#0A4D2E] text-white p-6 sm:p-10 border border-[#0A4D2E]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5">
          <PhotoSlot 
            aspectRatio="4/5" 
            src="/images/foto-aspal-core-drill.jpg"
            alt="Uji laboratorium core drill dan uji tekan silinder"
            label="Uji Tekan Silinder & Kuat Tarik" 
            sublabel="Sertifikat Lab Vendor Sah" 
            class="bg-black/20 border-white/20 text-white" 
          />
        </div>

        <div class="lg:col-span-7 space-y-6">
          <div>
            <div class="text-xs font-mono font-bold text-[#FFC700] uppercase tracking-wider mb-1">03 &mdash; INTEGRITAS TEKNIS</div>
            <h2 class="text-2xl sm:text-3xl font-black text-white">Panel Presisi Spesifikasi</h2>
            <p class="text-xs sm:text-sm text-gray-100 mt-2 leading-relaxed">
              Kepatuhan mutlak terhadap parameter teknik yang disyaratkan oleh konsultan dan pengawas lapangan:
            </p>
          </div>

          <div class="space-y-4 pt-2">
            <div class="border-b border-white/20 pb-3">
              <span class="text-xs font-mono font-bold text-[#FFC700] uppercase block mb-1">Mutu</span>
              <p class="text-xs sm:text-sm text-gray-100 leading-relaxed">
                Nomenklatur baku SNI dan PUPR: Kuat tekan beton kubus K-100 s.d K-500 atau konversi silinder f'c (MPa), baja BjTP 280 & BjTS 420B, serta aspal AC-WC / AC-BC.
              </p>
            </div>

            <div class="border-b border-white/20 pb-3">
              <span class="text-xs font-mono font-bold text-[#FFC700] uppercase block mb-1">Standar</span>
              <p class="text-xs sm:text-sm text-gray-100 leading-relaxed">
                Rujukan resmi SNI 2847, SNI 2052:2017, dan Spesifikasi Umum Bina Marga (Perkerasan Aspal).
              </p>
            </div>

            <div>
              <span class="text-xs font-mono font-bold text-[#FFC700] uppercase block mb-1">Dokumen</span>
              <p class="text-xs sm:text-sm text-gray-100 leading-relaxed">
                Verifikasi berkas asli (Mill Certificate, Sertifikat Uji Lab Vendor, Job Mix Formula) dilayani secara tertib via permohonan resmi email demi pencegahan penyalahgunaan berkas tender.
              </p>
            </div>
          </div>

          <div class="pt-2">
            <Button href={mailtoUrl}>
              <span>Ajukan Verifikasi Dokumen via Email</span>
              <svg class="w-3.5 h-3.5 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 07. PANDUAN TEKNIS (3 Artikel) -->
  <section id="artikel" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider mb-1">04 &mdash; EDUKASI & REFERENSI</div>
        <h2 class="text-2xl sm:text-3xl font-black text-ink">Artikel & Panduan Teknis</h2>
      </div>
      <span class="text-xs font-mono text-gray-500">Kajian SNI & Praktik Konstruksi Lapangan</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/artikel/precast-u-ditch-vs-batu-kali" class="border border-border-base rounded-[8px] bg-surface p-5 industrial-card flex flex-col justify-between group">
        <div>
          <PhotoSlot 
            aspectRatio="16/9" 
            src="/images/foto-box-culvert.jpg"
            alt="Pemasangan saluran precast beton"
            label="Precast Saluran" 
            class="mb-4" 
          />
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-mono text-green-primary font-bold bg-[#E5F6E8] px-2 py-0.5 rounded">Beton / Saluran</span>
            <span class="text-gray-500 font-mono text-[11px]">4 mnt baca</span>
          </div>
          <h3 class="text-base font-bold text-ink mb-2 leading-snug group-hover:text-green-primary transition-colors">
            Precast U-Ditch vs Pasangan Batu Kali: Efisiensi Waktu & Biaya Saluran Drainase
          </h3>
          <p class="text-xs text-ink opacity-80 line-clamp-3 mb-4">
            Analisis kecepatan pemasangan, durabilitas mutu beton K-350, dan studi kasus penanganan galian di jalan arteri perkotaan.
          </p>
        </div>
        <div class="pt-3 border-t border-border-base flex justify-between items-center text-xs">
          <span class="font-mono text-gray-500">SNI 03-6880</span>
