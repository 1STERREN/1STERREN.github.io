---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import { getCollection } from 'astro:content';
import { createWhatsAppUrl, createBoQMailtoUrl } from '@/utils/links';
import { articlePhotoMap } from '@/utils/materialPhotos';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles }
  }));
}

const { article, allArticles } = Astro.props;
const { Content } = await article.render();
const waUrl = createWhatsAppUrl(`Konsultasi Artikel: ${article.data.title}`);
const mailtoUrl = createBoQMailtoUrl();

// Ambil 3 artikel rekomendasi (prioritaskan kategori relevan)
const relatedArticles = (allArticles || [])
  .filter(a => a.slug !== article.slug)
  .sort((a, b) => (b.data.category === article.data.category ? 1 : 0) - (a.data.category === article.data.category ? 1 : 0))
  .slice(0, 3);
---

<Layout title={`${article.data.title} | CV. Serba Niaga Jaya`}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-gray-500 mb-6">
      <a href="/" class="hover:text-green-primary">Beranda</a>
      <span>/</span>
      <a href="/artikel" class="hover:text-green-primary">Artikel & Panduan Teknis</a>
      <span>/</span>
      <span class="text-ink font-bold capitalize">{article.data.category}</span>
    </nav>

    <!-- Meta Badges -->
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="px-2.5 py-1 rounded bg-[#0F7B3F] text-white text-xs font-bold uppercase">{article.data.category}</span>
      <span class="px-2.5 py-1 rounded bg-[#E5F6E8] text-[#0A4D2E] text-xs font-bold border border-[#12A150]/30 font-mono">Panduan Teknis Resmi</span>
      <span class="px-2.5 py-1 rounded bg-green-light text-ink text-xs font-bold">{article.data.sniReference}</span>
    </div>

    <!-- H1 Title -->
    <h1 class="text-2xl sm:text-4xl font-black text-ink mb-4 leading-tight">
      {article.data.title}
    </h1>

    <div class="flex items-center gap-4 text-xs font-mono text-gray-500 pb-6 border-b border-border-base mb-8">
      <span>Rilis: {article.data.publishedAt}</span>
      <span>•</span>
      <span>Estimasi: {article.data.readingTimeMinutes} Menit Baca</span>
    </div>

    <!-- Hero Frame Foto Riil Lapangan -->
    <PhotoSlot 
      aspectRatio="16/9" 
      label={`Dokumentasi Teknis: ${article.data.title}`} 
      src={articlePhotoMap[article.slug] || '/images/foto-cor-slab.jpg'}
      alt={`Dokumentasi Teknis Lapangan ${article.data.title}`}
      class="mb-8" 
    />

    <!-- Technical Note Box -->
    <div class="bg-[#FFF7CC] border-l-4 border-[#FFC700] p-4 rounded-[6px] mb-8 text-xs sm:text-sm text-ink leading-relaxed">
      <strong>Catatan Teknis Rekayasa:</strong> Parameter, data rasio, dan komparasi pada panduan teknis ini disusun berbasis standar nasional SNI, ASTM, dan Spesifikasi Umum Bina Marga PUPR sebagai rujukan teknis di lapangan. Selalu padukan dengan Rencana Kerja & Syarat-syarat (RKS) serta arahan konsultan pengawas proyek Anda.
    </div>

    <!-- Article Content -->
    <div class="prose max-w-none text-ink leading-relaxed text-sm sm:text-base space-y-6">
      <Content />
    </div>

    <!-- Kotak Ajakan Konsultasi & Pengadaan Terpadu (Satu Pintu Tanpa Duplikasi) -->
    <div class="mt-12 border-2 border-[#12A150]/60 bg-[#F3F8EE] rounded-[10px] p-6 sm:p-8 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <span class="px-3 py-1 rounded bg-[#E5F6E8] text-[#0F7B3F] text-xs font-bold font-mono tracking-wider border border-[#0F7B3F]/20">
          {article.data.actionBadge || article.data.promoBadge || 'AJAKAN PENGADAAN & KONSULTASI'}
        </span>
        <span class="text-xs font-mono text-[#0F7B3F] font-bold">
          CV. SERBA NIAGA JAYA
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-ink mb-2">
        {article.data.actionHeadline || article.data.promoHeadline || 'Konsultasi Spesifikasi & Pengadaan Proyek'}
      </h3>
      <p class="text-xs sm:text-sm text-ink opacity-85 leading-relaxed mb-6">
        {article.data.actionDetails || article.data.promoDetails || 'Konsultasikan kebutuhan spesifikasi material, penjadwalan ritase armada, dan penawaran resmi untuk proyek Anda bersama tim teknis kami.'}
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <Button href={createWhatsAppUrl(`Konsultasi Pengadaan: ${article.data.actionHeadline || article.data.promoHeadline || article.data.title}`)} target="_blank">
          {article.data.actionCtaText || article.data.promoCtaText || 'Hubungi Tim Teknis via WhatsApp'}
        </Button>
        <Button href={mailtoUrl} variant="secondary">
          Kirim Gambar Kerja / BoQ via Email
        </Button>
      </div>
    </div>

    <!-- REKOMENDASI ARTIKEL & PANDUAN TEKNIS LAINNYA -->
    {relatedArticles && relatedArticles.length > 0 && (
      <div class="mt-14 pt-10 border-t border-border-base">
        <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <span class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider block mb-1">
              REFERENSI PENGAYAAN TEKNIS
            </span>
            <h2 class="text-xl sm:text-2xl font-black text-ink">
              Rekomendasi Artikel Teknis Terkait
            </h2>
            <p class="text-xs sm:text-sm text-ink opacity-80 mt-1">
              Pelajari komparasi mutu SNI, studi kasus kegagalan struktur, dan efisiensi pengadaan material lainnya.
            </p>
          </div>
          <a 
            href="/artikel" 
            class="text-xs font-bold text-green-primary hover:underline inline-flex items-center gap-1 shrink-0 font-mono"
          >
            <span>Semua Panduan Teknis</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedArticles.map((rel) => (
            <a 
              href={`/artikel/${rel.slug}`} 
              class="group border border-border-base rounded-[10px] bg-surface p-4 hover:border-[#12A150] hover:shadow-md transition-all flex flex-col justify-between block cursor-pointer"
            >
              <div>
                <div class="h-28 rounded-[6px] overflow-hidden mb-3 border border-border-base">
                  <img 
                    src={articlePhotoMap[rel.slug] || '/images/foto-cor-slab.jpg'} 
                    alt={rel.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] font-mono text-gray-500 mb-2">
                  <span class="px-2 py-0.5 rounded bg-[#E5F6E8] text-[#0A4D2E] font-bold uppercase text-[10px]">
                    {rel.data.category}
                  </span>
                  <span>{rel.data.readingTimeMinutes} mnt baca</span>
                </div>
                <h3 class="text-sm font-black text-ink group-hover:text-green-primary transition-colors line-clamp-2 leading-snug mb-2">
                  {rel.data.title}
                </h3>
                <p class="text-xs text-ink opacity-75 line-clamp-2 leading-relaxed mb-4">
                  {rel.data.summary}
                </p>
              </div>
              <div class="pt-3 border-t border-border-base/70 flex items-center justify-between text-xs">
                <span class="text-[10px] font-mono text-gray-500 truncate max-w-[140px]">
                  {rel.data.sniReference}
                </span>
                <span class="text-green-primary font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-0.5">
                  <span>Baca</span>
                  <span>&rarr;</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- PROMOSI EMPAT KATEGORI PENGADAAN (Pasokan Material Terpadu) -->
    <div class="mt-12 pt-10 border-t border-border-base">
      <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-xs font-mono font-bold text-green-primary uppercase tracking-wider block mb-1">
            PASOKAN MATERIAL TERPADU
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-ink">
            Empat Kategori Pengadaan Proyek
          </h2>
          <p class="text-xs sm:text-sm text-ink opacity-80 mt-1">
            Penuhi seluruh rantai pasok konstruksi dari satu sumber resmi dengan faktur pajak & uji lab SNI.
          </p>
        </div>
        <a 
          href="/produk" 
          class="text-xs font-bold text-green-primary hover:underline inline-flex items-center gap-1 shrink-0 font-mono"
        >
          <span>Katalog Lengkap & Keranjang</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Grid 4 Kategori Pengadaan -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 01. Niaga Beton -->
        <a 
          href="/niaga-beton" 
          class="group border border-border-base rounded-[10px] bg-surface p-5 hover:border-[#12A150] hover:shadow-md transition-all flex flex-col justify-between block cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-green-primary">01 &bull; BETON</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#E5F6E8] text-[#0A4D2E] font-bold">
                SNI 2847 / PUPR
              </span>
            </div>
            <h3 class="text-base font-black text-ink group-hover:text-green-primary transition-colors mb-1">
              Beton Ready Mix & Precast
            </h3>
            <p class="text-xs text-ink opacity-80 leading-relaxed mb-3">
              Cor truk mixer mutu K-175 s/d K-500, saluran U-Ditch, Box Culvert presisi, dan sewa concrete pump.
            </p>
          </div>
          <div class="text-xs font-bold text-green-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 mt-2">
            <span>Buka Katalog Niaga Beton</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- 02. Niaga Baja -->
        <a 
          href="/niaga-baja" 
          class="group border border-border-base rounded-[10px] bg-surface p-5 hover:border-[#12A150] hover:shadow-md transition-all flex flex-col justify-between block cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-green-primary">02 &bull; BAJA</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#E5F6E8] text-[#0A4D2E] font-bold">
                SNI 2052:2017
              </span>
            </div>
            <h3 class="text-base font-black text-ink group-hover:text-green-primary transition-colors mb-1">
              Baja Tulangan & Profil
            </h3>
            <p class="text-xs text-ink opacity-80 leading-relaxed mb-3">
              Besi ulir BjTS 420B, polos TP 280, wiremesh lembar/rol M6-M10, baja profil WF, dan atap uPVC Alderon.
            </p>
          </div>
          <div class="text-xs font-bold text-green-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 mt-2">
            <span>Buka Katalog Niaga Baja</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- 03. Niaga Aspal -->
        <a 
          href="/niaga-aspal" 
          class="group border border-border-base rounded-[10px] bg-surface p-5 hover:border-[#12A150] hover:shadow-md transition-all flex flex-col justify-between block cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-green-primary">03 &bull; ASPAL</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#E5F6E8] text-[#0A4D2E] font-bold">
                Bina Marga Rev 3
              </span>
            </div>
            <h3 class="text-base font-black text-ink group-hover:text-green-primary transition-colors mb-1">
              Aspal Hotmix & Bitumen
            </h3>
            <p class="text-xs text-ink opacity-80 leading-relaxed mb-3">
              Hotmix AC-WC, AC-BC, Sand Sheet, aspal drum Pertamina 60/70, Prime/Tack Coat & paket jasa gelar.
            </p>
          </div>
          <div class="text-xs font-bold text-green-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 mt-2">
            <span>Buka Katalog Niaga Aspal</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- 04. Niaga Batuan -->
        <a 
          href="/niaga-batuan" 
          class="group border border-border-base rounded-[10px] bg-surface p-5 hover:border-[#12A150] hover:shadow-md transition-all flex flex-col justify-between block cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-green-primary">04 &bull; BATUAN</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#E5F6E8] text-[#0A4D2E] font-bold">
                Kadar Lumpur &lt; 5%
              </span>
            </div>
            <h3 class="text-base font-black text-ink group-hover:text-green-primary transition-colors mb-1">
              Agregat Pasir & Batu Split
            </h3>
            <p class="text-xs text-ink opacity-80 leading-relaxed mb-3">
              Pasir cor cuci ekstra bersih Bangka/Rangkas, batu split cor 1/2, abu batu, sirdam, dan agregat Base A/B.
            </p>
          </div>
          <div class="text-xs font-bold text-green-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 mt-2">
            <span>Buka Katalog Niaga Batuan</span>
            <span>&rarr;</span>
          </div>
        </a>
      </div>

      <!-- Banner Belanja Keranjang Produk -->
      <div class="mt-6 p-4 rounded-[8px] bg-[#FFC700]/15 border border-[#FFC700] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-[#FFC700] text-ink font-black flex items-center justify-center shrink-0 text-base">
            🛒
          </span>
          <div>
            <h4 class="text-xs sm:text-sm font-black text-ink">Beli Langsung Lewat Keranjang Digital</h4>
            <p class="text-xs text-ink opacity-85">Pilih material dari 4 kategori pengadaan, tentukan volume, dan kirim rincian pesanan langsung ke WhatsApp kami.</p>
          </div>
        </div>
        <a 
          href="/produk" 
          class="shrink-0 bg-[#FFC700] hover:bg-[#E5B300] text-ink font-bold text-xs py-2.5 px-4 rounded-[6px] shadow-xs transition-all inline-flex items-center gap-1.5"
        >
          <span>Buka Master Marketplace</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
