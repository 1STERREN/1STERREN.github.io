---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { createWhatsAppUrl } from '@/utils/links';
import { getMaterialPhoto } from '@/utils/materialPhotos';

const products = await getCollection('products');

// Helper satuan otomatis
function getMaterialUnit(cat: string, name: string): string {
  const n = name.toLowerCase();
  if (cat === 'beton') {
    if (n.includes('pompa')) return 'Sesi';
    if (n.includes('u-ditch') || n.includes('cover') || n.includes('box culvert') || n.includes('buis') || n.includes('kanstin')) return 'Pcs';
    if (n.includes('paving')) return 'm²';
    return 'm³';
  }
  if (cat === 'baja') {
    if (n.includes('wiremesh')) return 'Lembar';
    if (n.includes('alderon') || n.includes('spandek') || n.includes('polycarbonate')) return 'Lembar';
    if (n.includes('plat')) return 'Lembar';
    return 'Batang';
  }
  if (cat === 'aspal') {
    if (n.includes('drum') || n.includes('curah')) return 'Drum';
    if (n.includes('emulsi') || n.includes('cair')) return 'Drum';
    if (n.includes('jasa')) return 'm²';
    return 'Ton';
  }
  if (cat === 'batuan') {
    if (n.includes('bata') || n.includes('hebel')) return 'm³';
    if (n.includes('pasir')) return 'Rit';
    if (n.includes('split') || n.includes('agregat') || n.includes('makadam') || n.includes('sirdam')) return 'Rit';
    if (n.includes('batu kali') || n.includes('batu belah')) return 'Rit';
    return 'Rit';
  }
  return 'Unit';
}

// Helper badge standar resmi
function getMaterialStandardBadge(cat: string, name: string): string {
  const n = name.toLowerCase();
  if (cat === 'beton') {
    if (n.includes('kelas iii') || n.includes('k-350') || n.includes('k-500')) return 'SNI 2847 Heavy';
    if (n.includes('precast') || n.includes('u-ditch') || n.includes('box')) return 'Precast SNI K-350';
    if (n.includes('pompa')) return 'Armada Pompa SNJ';
    return 'SNI 2847 / PBI';
  }
  if (cat === 'baja') {
    if (n.includes('ulir') || n.includes('ts 420')) return 'SNI 2052 BjTS 420';
    if (n.includes('polos')) return 'SNI 2052 BjTP 280';
    if (n.includes('wf') || n.includes('h-beam')) return 'ASTM / JIS Grade';
    if (n.includes('alderon')) return 'uPVC Twinwall';
    return 'Mill Sheet SNI';
  }
  if (cat === 'aspal') {
    if (n.includes('ac-wc') || n.includes('ac-bc')) return 'Bina Marga Rev 3';
    if (n.includes('pen 60/70')) return 'Pertamina Resmi';
    if (n.includes('emulsi') || n.includes('tack') || n.includes('prime')) return 'SNI 03-4798';
    return 'Standar Jalan Raya';
  }
  if (cat === 'batuan') {
    if (n.includes('pasir')) return 'Lumpur < 5%';
    if (n.includes('split')) return 'Gradasi Kuat Tekan';
    if (n.includes('hebel')) return 'Presisi AAC SNI';
    return 'Kuari Terverifikasi';
  }
  return 'Standar SNI';
}

// Gabungkan seluruh item dari 4 unit bisnis ke dalam satu daftar master
const allMasterItems = products.flatMap((p) => {
  return p.data.sections.flatMap((sec, sIdx) => {
    return sec.items.map((item, itemIdx) => {
      const cat = p.data.category;
      return {
        id: `${cat}-${sIdx}-${itemIdx}-${item.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`,
        name: item.name,
        description: item.description || '',
        category: cat,
        unitBusinessName: p.data.unitBusinessName,
        sectionTitle: sec.title,
        unit: getMaterialUnit(cat, item.name),
        badge: getMaterialStandardBadge(cat, item.name),
        photoSrc: getMaterialPhoto(cat, item.name)
      };
    });
  });
});
---

<Layout title="Katalog Terpadu Seluruh Produk & Layanan | CV. Serba Niaga Jaya">
  <!-- Header Banner Halaman Produk -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#E5F6E8] text-xs font-mono font-bold text-[#0F7B3F] mb-3 border border-[#12A150]/20">
        <span class="w-2 h-2 rounded-full bg-[#FFC700] animate-pulse"></span>
        <span>DAFTAR LENGKAP SEMUA MATERIAL KONSTRUKSI</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-ink tracking-tight mb-4">
        Katalog Terpadu Seluruh Pasokan Material
      </h1>
      <p class="text-sm sm:text-base text-ink opacity-85 leading-relaxed">
        Pusat belanja material konstruksi CV. Serba Niaga Jaya. Pilih barang dari unit Beton, Baja, Aspal, dan Batuan dalam satu tempat, atur volume pesanan, dan ajukan penawaran resmi melalui checkout WhatsApp.
      </p>
    </div>

    <!-- Filter Pills & Search Bar (Menggunakan div/input, TANPA TAG FORM PUBLIK) -->
    <div class="bg-surface-soft border border-border-base rounded-[12px] p-4 sm:p-5 mb-8 shadow-xs">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        
        <!-- Filter Kategori Unit Bisnis -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 max-w-full" id="category-filter-buttons">
          <button 
            type="button" 
            data-filter="all"
            class="filter-pill-btn active px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-[#0A4D2E] text-white shadow-xs shrink-0"
          >
            Semua ({allMasterItems.length})
          </button>
          <button 
            type="button" 
            data-filter="beton"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Beton
          </button>
          <button 
            type="button" 
            data-filter="baja"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Baja
          </button>
          <button 
            type="button" 
            data-filter="aspal"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Aspal
          </button>
          <button 
            type="button" 
            data-filter="batuan"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Batuan
          </button>
        </div>

        <!-- Realtime Search Input -->
        <div class="relative w-full lg:w-80 shrink-0">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="search-input" 
            placeholder="Cari nama material / mutu..."
            class="w-full pl-9 pr-4 py-2 text-xs rounded-[6px] border border-border-base bg-surface text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#FFC700]"
          />
        </div>

      </div>

      <!-- Counter Tampilan Real-Time -->
      <div class="mt-3 pt-3 border-t border-border-base/50 flex items-center justify-between text-[11px] text-ink/70">
        <span>Menampilkan <strong id="visible-count" class="text-ink font-mono">{allMasterItems.length}</strong> material konstruksi</span>
        <span class="hidden sm:inline">Penyedia Resmi SNJ &bull; Jabodetabek, Cikarang & Karawang</span>
      </div>
    </div>
  </section>

  <!-- Master Marketplace Product Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div id="master-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {allMasterItems.map((item) => (
        <div 
          class="master-product-card border border-border-base rounded-[10px] bg-surface overflow-hidden flex flex-col justify-between hover:border-[#12A150]/70 hover:shadow-lg transition-all duration-200 group"
          data-category={item.category}
          data-name={item.name.toLowerCase()}
          data-desc={item.description.toLowerCase()}
          data-unitbusiness={item.unitBusinessName.toLowerCase()}
        >
          <div>
            <!-- Visual Thumbnail Header Bersih & Terang -->
            <div class="relative h-44 bg-surface-soft overflow-hidden border-b border-border-base">
              <img 
                src={item.photoSrc} 
                alt={item.name} 
                loading="lazy" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              
              <!-- Badges Kontras Tinggi -->
              <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between gap-1.5">
                <span class="bg-surface/95 text-[9px] font-mono font-bold text-[#0A4D2E] px-2 py-0.5 rounded shadow-xs border border-border-base">
                  {item.unitBusinessName}
                </span>
                <span class="bg-[#FFC700] text-ink text-[9px] font-mono font-black px-1.5 py-0.5 rounded shadow-xs">
                  {item.badge}
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-4">
              <div class="flex items-center justify-between text-[10px] font-mono text-gray-500 mb-1.5">
                <span class="truncate max-w-[130px]">{item.sectionTitle}</span>
                <span class="text-[#0A4D2E] font-bold bg-[#E5F6E8] px-2 py-0.5 rounded border border-[#12A150]/20">Satuan: {item.unit}</span>
              </div>
              <h3 class="text-sm font-black text-ink mb-1.5 group-hover:text-green-primary transition-colors line-clamp-2 min-h-[2.5rem]">
                {item.name}
              </h3>
              {item.description && (
                <p class="text-[11px] text-ink/75 leading-relaxed line-clamp-2 min-h-[2rem]">
                  {item.description}
                </p>
              )}
            </div>
          </div>

          <!-- Stepper & Add to Cart -->
          <div class="p-4 pt-0">
            <div class="pt-2.5 border-t border-border-base/70">
              
              <!-- Quantity Stepper -->
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="text-[10px] font-bold text-ink/80">Kebutuhan:</span>
                <div class="flex items-center border border-border-base rounded-[6px] overflow-hidden bg-surface-soft shadow-xs">
                  <button 
                    type="button" 
                    class="card-qty-minus px-2 py-0.5 text-ink/75 hover:text-ink hover:bg-surface font-bold text-xs transition-colors" 
                    aria-label="Kurangi Kuantitas"
                  >
                    -
                  </button>
                  <span class="card-qty-value px-2.5 py-0.5 font-mono text-xs font-bold text-ink bg-surface min-w-[36px] text-center border-x border-border-base">
                    1
                  </span>
                  <button 
                    type="button" 
                    class="card-qty-plus px-2 py-0.5 text-ink/75 hover:text-ink hover:bg-surface font-bold text-xs transition-colors" 
                    aria-label="Tambah Kuantitas"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="grid grid-cols-12 gap-1.5">
                <button 
                  type="button"
                  class="col-span-8 btn-add-to-cart bg-[#FFC700] hover:bg-[#E5B300] active:scale-98 text-ink font-bold text-xs py-2 px-2.5 rounded-[6px] shadow-sm flex items-center justify-center gap-1 transition-all"
                  data-id={item.id}
                  data-name={item.name}
                  data-unit-business={item.unitBusinessName}
                  data-category={item.category}
                  data-unit={item.unit}
                  data-spec={item.description}
                >
                  <svg class="w-3.5 h-3.5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                  <span>+ Keranjang</span>
                </button>

                <a 
                  href={createWhatsAppUrl(`Halo CV. SNJ, saya ingin tanya penawaran material: ${item.name} (${item.unitBusinessName})`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="col-span-4 border border-border-base hover:bg-surface-soft active:scale-98 text-ink font-bold text-[11px] py-2 px-1.5 rounded-[6px] flex items-center justify-center gap-1 transition-colors"
                  title="Tanya ke WhatsApp"
                >
                  <svg class="w-3.5 h-3.5 text-green-primary" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.97.53 1.77.82 2.79.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.766-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.435-4.733-1.199l-5.267 1.381 1.405-5.137c-.896-1.493-1.405-3.237-1.405-5.045 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
                  </svg>
                  <span>Tanya</span>
                </a>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State Pencarian -->
    <div id="no-search-results" class="py-16 text-center bg-surface-soft border border-border-base rounded-[10px] hidden">
      <div class="text-3xl mb-2">🔍</div>
      <h3 class="text-base font-bold text-ink">Tidak ada material yang cocok dengan pencarian</h3>
      <p class="text-xs text-ink/70 mt-1">Coba gunakan kata kunci lain seperti beton, rebar, hotmix, atau batu split.</p>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-pill-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.master-product-card');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-search-results');

    let currentFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let count = 0;
      cards.forEach(card => {
        const cat = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        const unitBiz = card.getAttribute('data-unitbusiness') || '';

        const matchesCat = (currentFilter === 'all') || (cat === currentFilter);
        const matchesQuery = !searchQuery || 
          name.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          unitBiz.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          count += 1;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = String(count);
      if (noResultsEl) {
        if (count === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }
    }

    // Filter Buttons Handler
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#0A4D2E]', 'text-white', 'shadow-xs');
          b.classList.add('bg-surface', 'text-ink');
        });
        btn.classList.add('active', 'bg-[#0A4D2E]', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-surface', 'text-ink');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    // Realtime Search Handler
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });

    // Card Stepper Handler
    document.querySelectorAll('.master-product-card').forEach(card => {
      const minusBtn = card.querySelector('.card-qty-minus');
      const plusBtn = card.querySelector('.card-qty-plus');
      const qtyEl = card.querySelector('.card-qty-value');

      minusBtn?.addEventListener('click', () => {
        let val = Number(qtyEl?.textContent?.trim()) || 1;
        if (val > 1) {
          val -= 1;
          if (qtyEl) qtyEl.textContent = String(val);
        }
      });

      plusBtn?.addEventListener('click', () => {
        let val = Number(qtyEl?.textContent?.trim()) || 1;
        val += 1;
        if (qtyEl) qtyEl.textContent = String(val);
      });
    });

    // Add To Cart Event
    document.querySelectorAll('.btn-add-to-cart').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.master-product-card');
        const qtyEl = card?.querySelector('.card-qty-value');
        const qty = Number(qtyEl?.textContent?.trim()) || 1;

        const id = btn.getAttribute('data-id') || '';
        const name = btn.getAttribute('data-name') || '';
        const unitBusiness = btn.getAttribute('data-unit-business') || '';
        const category = btn.getAttribute('data-category') || '';
        const unit = btn.getAttribute('data-unit') || '';
        const spec = btn.getAttribute('data-spec') || '';

        const item = { id, name, unitBusiness, category, unit, spec, qty };

        // Read LocalStorage
        let cart = [];
        try {
          const raw = localStorage.getItem('snj_cart_items_v1');
          cart = raw ? JSON.parse(raw) : [];
        } catch (e) {
          cart = [];
        }

        const existingIdx = cart.findIndex((i: { id: string }) => i.id === id);
        if (existingIdx >= 0) {
          cart[existingIdx].qty += qty;
        } else {
          cart.push(item);
        }

        try {
          localStorage.setItem('snj_cart_items_v1', JSON.stringify(cart));
        } catch (e) {
          console.error(e);
        }

        // Notify global events
        window.dispatchEvent(new CustomEvent('snj-cart-updated', { detail: cart }));
        window.dispatchEvent(new CustomEvent('snj-toast', { detail: `${qty} ${unit} ${name} ditambahkan ke keranjang!` }));

        // Micro-interaction button state
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-green-800 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-[#0A4D2E] font-black">Ditambahkan</span>
        `;
        btn.classList.add('bg-[#E5F6E8]', 'border', 'border-[#12A150]');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-[#E5F6E8]', 'border', 'border-[#12A150]');
        }, 1200);
      });
    });

  });
</script>
