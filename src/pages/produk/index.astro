---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { createWhatsAppUrl } from '@/utils/links';
import { getMaterialPhoto } from '@/utils/materialPhotos';

const products = await getCollection('products');

// Gabungkan seluruh item dari 4 unit niaga ke dalam satu daftar master
const allMasterItems = products.flatMap((p) => {
  return p.data.sections.flatMap((sec, sIdx) => {
    return sec.items.map((item, itemIdx) => {
      const cat = p.data.category;
      return {
        id: `${cat}-${sIdx}-${itemIdx}-${item.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`,
        name: item.name,
        description: item.description || '',
        category: cat,
        unitBusinessName: p.data.unitBusinessName,
        sectionTitle: sec.title,
        photoSrc: getMaterialPhoto(cat, item.name)
      };
    });
  });
});
---

<Layout title="Katalog Terpadu Seluruh Produk & Layanan | CV. Serba Niaga Jaya">
  <!-- Header Banner Halaman Produk -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#E5F6E8] text-xs font-mono font-bold text-[#0F7B3F] mb-3 border border-[#12A150]/20">
        <span class="w-2 h-2 rounded-full bg-[#FFC700] animate-pulse"></span>
        <span>DAFTAR LENGKAP SEMUA MATERIAL KONSTRUKSI</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-ink tracking-tight mb-4">
        Katalog Terpadu Seluruh Pasokan Material
      </h1>
      <p class="text-sm sm:text-base text-ink opacity-85 leading-relaxed">
        Pusat belanja material konstruksi CV. Serba Niaga Jaya. Pilih barang dari unit Beton, Baja, Aspal, dan Batuan dalam satu tempat, atur volume pesanan, dan ajukan penawaran resmi melalui checkout WhatsApp.
      </p>
    </div>

    <!-- Filter Pills & Search Bar (Menggunakan div/input, TANPA TAG FORM PUBLIK) -->
    <div class="bg-surface-soft border border-border-base rounded-[12px] p-4 sm:p-5 mb-8 shadow-xs">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        
        <!-- Filter Kategori Unit Bisnis -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 max-w-full" id="category-filter-buttons">
          <button 
            type="button" 
            data-filter="all"
            class="filter-pill-btn active px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-[#0A4D2E] text-white shadow-xs shrink-0"
          >
            Semua ({allMasterItems.length})
          </button>
          <button 
            type="button" 
            data-filter="beton"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Beton
          </button>
          <button 
            type="button" 
            data-filter="baja"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Baja
          </button>
          <button 
            type="button" 
            data-filter="aspal"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Aspal
          </button>
          <button 
            type="button" 
            data-filter="batuan"
            class="filter-pill-btn px-3.5 py-2 rounded-[6px] text-xs font-bold font-mono transition-all bg-surface border border-border-base text-ink hover:border-[#12A150] shrink-0"
          >
            Niaga Batuan
          </button>
        </div>

        <!-- Realtime Search Input -->
        <div class="relative w-full lg:w-80 shrink-0">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="search-input" 
            placeholder="Cari nama material / mutu..."
            class="w-full pl-9 pr-4 py-2 text-xs rounded-[6px] border border-border-base bg-surface text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#FFC700]"
          />
        </div>

      </div>

      <!-- Counter Tampilan Real-Time -->
      <div class="mt-3 pt-3 border-t border-border-base/50 flex items-center justify-between text-[11px] text-ink/70">
        <span>Menampilkan <strong id="visible-count" class="text-ink font-mono">{allMasterItems.length}</strong> material konstruksi</span>
        <span class="hidden sm:inline">Penyedia Resmi SNJ &bull; Jabodetabek, Cikarang & Karawang</span>
      </div>
    </div>
  </section>

  <!-- Master Marketplace Product Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div id="master-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {allMasterItems.map((item) => (
        <div 
          class="master-product-card border border-border-base rounded-[10px] bg-surface overflow-hidden flex flex-col justify-between hover:border-[#12A150]/70 hover:shadow-lg transition-all duration-200 group"
          data-category={item.category}
          data-name={item.name.toLowerCase()}
          data-desc={item.description.toLowerCase()}
          data-unitbusiness={item.unitBusinessName.toLowerCase()}
        >
          <div>
            <!-- Visual Thumbnail Header Bersih & Terang -->
            <div class="relative h-44 bg-surface-soft overflow-hidden border-b border-border-base">
              <img 
                src={item.photoSrc} 
                alt={item.name} 
                loading="lazy" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              
              <!-- Label Kategori Bersih -->
              <div class="absolute top-2.5 left-2.5">
                <span class="bg-surface/95 text-[9px] font-mono font-bold text-[#0A4D2E] px-2 py-0.5 rounded shadow-xs border border-border-base">
                  {item.unitBusinessName}
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-4">
              <div class="text-[10px] font-mono text-gray-500 mb-1.5">
                <span class="truncate block">{item.sectionTitle}</span>
              </div>
              <h3 class="text-sm font-black text-ink mb-1.5 group-hover:text-green-primary transition-colors line-clamp-2 min-h-[2.5rem]">
                {item.name}
              </h3>
              {item.description && (
                <p class="text-[11px] text-ink/75 leading-relaxed line-clamp-2 min-h-[2rem]">
                  {item.description}
                </p>
              )}
            </div>
          </div>

          <!-- Tombol Tanya via WhatsApp Langsung -->
          <div class="p-4 pt-0">
            <div class="pt-2.5 border-t border-border-base/70">
              <a 
                href={createWhatsAppUrl(`Halo CV. Serba Niaga Jaya, saya ingin menanyakan spesifikasi & penawaran resmi untuk: ${item.name} (${item.unitBusinessName})`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-[#EAF7ED] hover:bg-[#D5EEDB] active:scale-98 text-[#0D6838] border border-[#12A150]/30 hover:border-[#12A150]/60 font-bold text-xs py-2.5 px-3 rounded-[6px] shadow-xs flex items-center justify-center gap-2 transition-all"
                title={`Tanya Penawaran ${item.name} via WhatsApp`}
              >
                <svg class="w-4 h-4 text-[#0D6838] shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.97.53 1.77.82 2.79.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.766-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.435-4.733-1.199l-5.267 1.381 1.405-5.137c-.896-1.493-1.405-3.237-1.405-5.045 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
                </svg>
                <span>Tanya via WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State Pencarian -->
    <div id="no-search-results" class="py-16 text-center bg-surface-soft border border-border-base rounded-[10px] hidden">
      <div class="text-3xl mb-2">🔍</div>
      <h3 class="text-base font-bold text-ink">Tidak ada material yang cocok dengan pencarian</h3>
      <p class="text-xs text-ink/70 mt-1">Coba gunakan kata kunci lain seperti beton, rebar, hotmix, atau batu split.</p>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-pill-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.master-product-card');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-search-results');

    let currentFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let count = 0;
      cards.forEach(card => {
        const cat = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        const unitBiz = card.getAttribute('data-unitbusiness') || '';

        const matchesCat = (currentFilter === 'all') || (cat === currentFilter);
        const matchesQuery = !searchQuery || 
          name.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          unitBiz.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          count += 1;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = String(count);
      if (noResultsEl) {
        if (count === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }
    }

    // Filter Buttons Handler
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#0A4D2E]', 'text-white', 'shadow-xs');
          b.classList.add('bg-surface', 'text-ink');
        });
        btn.classList.add('active', 'bg-[#0A4D2E]', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-surface', 'text-ink');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    // Realtime Search Handler
    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });
  });
</script>
