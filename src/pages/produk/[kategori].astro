---
import DivisionPage from '@/components/templates/DivisionPage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(p => ({
    params: { kategori: p.data.category },
    props: { productCategory: p.data }
  }));
}

const { productCategory } = Astro.props;

const photoMap: Record<string, string> = {
  beton: '/images/foto-cor-mixer-chute.jpg',
  baja: '/images/Serba Besi/Besi wf.JPG',
  aspal: '/images/serba aspal/Aspal AC WC.png',
  batuan: '/images/foto-pasir-dump-truck.jpg',
};
---

<DivisionPage 
  unitBusinessName={productCategory.unitBusinessName}
  category={productCategory.category}
  description={productCategory.description}
  sections={productCategory.sections}
  datasheetUrl={productCategory.datasheetUrl}
  photoSrc={photoMap[productCategory.category]}
/>
